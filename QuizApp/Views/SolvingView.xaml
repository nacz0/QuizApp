<UserControl x:Class="QuizApp.Views.SolvingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450">

    <UserControl.DataContext>
        <vm:SolvingViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:ScoreToVisibilityConverter x:Key="ScoreToVisibilityConverter"/>


        <!-- Styl dla nowoczesnych przycisków -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}" 
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#AAA"/>
                                <Setter Property="Foreground" Value="#EEE"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Styl dla przycisku wyglądającego jak tekst -->
        <Style x:Key="TextLikeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Górny panel -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Przyciski po lewej -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="0">
                <Button Style="{StaticResource ModernButton}" Content="Wczytaj quiz" Command="{Binding LoadQuizCommand}"/>
                <Button Style="{StaticResource ModernButton}" Content="Rozpocznij" Command="{Binding StartQuizCommand}"/>
            </StackPanel>

            <!-- Środkowy panel z numerem pytania i czasem -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1">
                <Button Style="{StaticResource TextLikeButton}"
            Content="{Binding CurrentQuestionNumber}"
            Visibility="{Binding IsQuizStarted, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource TextLikeButton}"
            Content="/"
            Visibility="{Binding IsQuizStarted, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource TextLikeButton}"
            Content="{Binding TotalQuestions}"
            Visibility="{Binding IsQuizStarted, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource TextLikeButton}"
            Content="{Binding FormattedElapsedTime, StringFormat='Czas: {0:mm\\:ss}'}"
            Visibility="{Binding IsQuizStarted, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Przyciski po prawej -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="2">
                <Button Style="{StaticResource ModernButton}" Content="Zakończ" Command="{Binding ShowResultsCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Pytanie i odpowiedzi -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsQuizStarted, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding CurrentQuestion.Text}" 
                       FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding CurrentQuestion.Answers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="5" Margin="5">
                            <CheckBox Content="{Binding Text}"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding IsSelectable}">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelectable}" Value="False"/>
                                                    <Condition Binding="{Binding IsCorrect}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="Green"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelectable}" Value="False"/>
                                                    <Condition Binding="{Binding IsCorrect}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="Red"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Score, StringFormat='Twój wynik: {0:F2}'}"
        FontSize="20" FontWeight="Bold" Foreground="DarkBlue"
        Visibility="{Binding Score, Converter={StaticResource ScoreToVisibilityConverter}}" 
        Margin="10"/>
            
        </StackPanel>



        <!-- Dolny panel nawigacji -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Visibility="{Binding IsQuizStarted, Converter={StaticResource BoolToVis}}">
            <Button Style="{StaticResource ModernButton}" Content="Poprzednie" Command="{Binding PreviousQuestionCommand}"/>
            <Button Style="{StaticResource ModernButton}" Content="Następne" Command="{Binding NextQuestionCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
