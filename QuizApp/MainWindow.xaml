<Window x:Class="QuizApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizApp"
        xmlns:views="clr-namespace:QuizApp.Views"
        xmlns:vm="clr-namespace:QuizApp.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MakerViewModel}">
            <views:MakerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SolvingViewModel}">
            <views:SolvingView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5"
                HorizontalAlignment="Center">
                <Button Content="Maker" Foreground="White" Background="DarkBlue"
                Command="{Binding NavigateMakerCommand}" Margin="5"
                Padding="10"/>
                <Button Content="Solving"  Foreground="White" Background="DarkGreen"
                Command="{Binding NavigateSolvingCommand}" Margin="5"
                Padding="10"/>
            </StackPanel>

            <!--Dynamiczne ładowanie widoku na podstawie modelu widoku
    ContentControl.Content będzie powiązany z właściwością CurrentViewModel 
    w obiekcie, który jest aktualnym DataContext
    To działa razem z tzw. DataTemplate-->

            <ContentControl Content="{Binding CurrentViewModel}" Margin="10"/>
        </DockPanel>
</Window>
